{
  "env": "your-env-id",
  "collections": [
    {
      "name": "users",
      "description": "用户档案",
      "permission": "仅创建者可读写",
      "fields": {
        "_openid": "string - 自动",
        "nickName": "string - 昵称",
        "bio": "string - 个人简介",
        "avatarUrl": "string - 头像URL",
        "skillLevel": "string - 技术水平 (beginner/elementary/intermediate/advanced/expert)",
        "playYears": "string - 球龄 (0-1/1-3/3-5/5-10/10+)",
        "playFrequency": "string - 打球频率",
        "playStyle": "string - 打球类型",
        "mainRacket": "string - 主力球拍",
        "shoes": "string - 球鞋",
        "shuttleBrand": "string - 常用球",
        "stringTension": "number - 拉线磅数",
        "preferredVenue": "string - 常用球馆",
        "city": "string - 所在城市",
        "playType": "string - 擅长打法",
        "hand": "string - 惯用手",
        "createTime": "date",
        "updateTime": "date"
      }
    },
    {
      "name": "bills",
      "description": "账单记录",
      "permission": "仅创建者可读写",
      "fields": {
        "_openid": "string - 自动",
        "amount": "number - 金额",
        "category": "string - 类别 (court/shuttle/drink/stringing/equipment/other)",
        "date": "date - 日期时间",
        "note": "string - 备注",
        "activityId": "string - 关联活动ID",
        "activityLabel": "string - 关联活动显示文本",
        "createTime": "date",
        "updateTime": "date"
      }
    },
    {
      "name": "activities",
      "description": "羽毛球活动",
      "permission": "仅创建者可读写",
      "fields": {
        "_openid": "string - 自动",
        "date": "date - 日期",
        "duration": "number - 运动时长（分钟）",
        "location": "string - 球馆名称",
        "playerCount": "number - 参与人数",
        "note": "string - 备注",
        "createTime": "date"
      }
    }
  ]
}
