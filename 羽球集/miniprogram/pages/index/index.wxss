/* pages/index/index.wxss */
.page {
  padding-bottom: 30rpx;
}

/* 头部卡片 */
.header-card {
  background: linear-gradient(135deg, #1aad19, #0d8a0d);
  color: #fff;
  padding: 40rpx 30rpx 30rpx;
  margin: 20rpx;
  border-radius: 20rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.greeting-text {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}

.greeting-sub {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 6rpx;
  display: block;
}

.header-avatar image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.4);
}

/* 本月概览 */
.summary-row {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.15);
  border-radius: 12rpx;
  padding: 20rpx 10rpx;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-value {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
}

.summary-value.amount {
  color: #ffe0b2;
}

.summary-label {
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 4rpx;
  display: block;
}

.summary-divider {
  width: 2rpx;
  height: 40rpx;
  background: rgba(255,255,255,0.2);
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  margin: 0 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-icon-bill { background: #fff3e0; }
.action-icon-play { background: #e8f5e9; }
.action-icon-chart { background: #e3f2fd; }
.action-icon-me { background: #f3e5f5; }

.action-label {
  font-size: 24rpx;
  color: #666;
}

/* 区块标题 */
.section {
  margin: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
}

.section-more {
  font-size: 26rpx;
  color: #999;
}

/* 账单项 */
.bill-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.04);
}

.bill-category {
  font-size: 28rpx;
  font-weight: 500;
}

.bill-date, .bill-note {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.bill-amount {
  font-size: 32rpx;
}

.bill-right {
  text-align: right;
}

/* 活动项 */
.activity-item {
  display: flex;
  justify-content: space-between;
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.04);
}

.activity-date {
  font-size: 28rpx;
  font-weight: 500;
}

.activity-duration {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
  display: block;
}

.activity-location {
  font-size: 26rpx;
  color: #666;
}

.activity-bill-count {
  font-size: 24rpx;
  color: #1aad19;
  margin-top: 4rpx;
  display: block;
}
