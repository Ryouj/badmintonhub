/* app.wxss - 全局样式 */
page {
  --primary: #1aad19;
  --primary-dark: #129611;
  --danger: #e74c3c;
  --warning: #f39c12;
  --info: #3498db;
  --text: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --bg: #f5f5f5;
  --bg-white: #ffffff;
  --border: #e8e8e8;
  --radius: 12rpx;
  --shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background-color: var(--bg);
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: var(--bg-white);
  border-radius: var(--radius);
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: var(--shadow);
}

/* 通用按钮 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius);
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
  border: none;
}

.btn-primary:active {
  background: var(--primary-dark);
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius);
  padding: 18rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
}

/* 通用标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  background: var(--primary);
  border-radius: 3rpx;
  margin-right: 12rpx;
}

/* 金额样式 */
.amount {
  font-weight: 700;
  color: #e74c3c;
  font-family: 'DIN', 'Helvetica Neue', sans-serif;
}

/* flex 布局 */
.flex-row {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--text-light);
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-state text {
  font-size: 28rpx;
}
