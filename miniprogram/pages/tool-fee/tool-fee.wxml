<!-- pages/tool-fee/tool-fee.wxml -->
<view class="page">
  <!-- 总费用 -->
  <view class="card">
    <view class="card-title">💰 总费用</view>
    <view class="amount-input-row">
      <text class="currency">¥</text>
      <input class="amount-input" type="digit" value="{{totalAmount}}" bindinput="onTotalInput" placeholder="0.00" />
    </view>
    <view class="detail-toggle" bindtap="toggleDetail">
      <text>{{showDetail ? '收起明细' : '展开明细（分项输入）'}}</text>
    </view>
    <block wx:if="{{showDetail}}">
      <view class="detail-list">
        <view class="detail-row" wx:for="{{detailItems}}" wx:key="key">
          <text class="detail-label">{{item.label}}</text>
          <view class="detail-input-box">
            <text class="detail-currency">¥</text>
            <input class="detail-input" type="digit" data-idx="{{index}}" bindinput="onDetailInput" value="{{item.amount}}" placeholder="0" />
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 人数（直接输入） -->
  <view class="card">
    <view class="card-title">👥 参与人数</view>
    <view class="count-row">
      <view class="count-item">
        <text class="count-icon male-icon">👨</text>
        <view class="count-stepper">
          <view class="stepper-btn" data-step="{{-1}}" bindtap="stepMale">−</view>
          <input class="stepper-input" type="number" value="{{maleCount}}" bindinput="onMaleInput" />
          <view class="stepper-btn" data-step="{{1}}" bindtap="stepMale">+</view>
        </view>
      </view>
      <view class="count-item">
        <text class="count-icon female-icon">👩</text>
        <view class="count-stepper">
          <view class="stepper-btn" data-step="{{-1}}" bindtap="stepFemale">−</view>
          <input class="stepper-input" type="number" value="{{femaleCount}}" bindinput="onFemaleInput" />
          <view class="stepper-btn" data-step="{{1}}" bindtap="stepFemale">+</view>
        </view>
      </view>
    </view>
    <view class="count-total">共 {{totalPeople}} 人</view>
  </view>

  <!-- 计费参数（全部可见） -->
  <view class="card">
    <view class="card-title">⚙️ 计费参数 <text class="card-hint">按需修改，不影响其他模式</text></view>
    <view class="param-row">
      <text class="param-label">女生折扣</text>
      <input class="param-input" type="digit" value="{{discountRatio}}" bindinput="onDiscountInput" />
      <text class="param-suffix">折（0.5=五折）</text>
    </view>
    <view class="param-row">
      <text class="param-label">固定人均</text>
      <text class="param-prefix">¥</text>
      <input class="param-input" type="digit" value="{{fixedAmount}}" bindinput="onFixedInput" />
      <text class="param-suffix">/人</text>
    </view>
    <view class="param-row">
      <text class="param-label">总轮次</text>
      <input class="param-input" type="number" value="{{totalRounds}}" bindinput="onRoundsInput" />
      <text class="param-suffix">轮</text>
    </view>
    <view class="param-row">
      <text class="param-label">嘉宾数</text>
      <input class="param-input" type="number" value="{{guestCount}}" bindinput="onGuestInput" />
      <text class="param-suffix">人（免单）</text>
    </view>
    <view class="param-row">
      <text class="param-label">败方数</text>
      <input class="param-input" type="number" value="{{loserCount}}" bindinput="onLoserInput" />
      <text class="param-suffix">人（买单）</text>
    </view>
  </view>

  <!-- 计算 -->
  <view class="calc-btn" bindtap="calculate">⚡ 一键计算所有模式</view>

  <!-- 结果：所有模式同时展示 -->
  <block wx:if="{{allResults}}">
    <view class="result-summary">
      <text class="summary-text">共 {{totalPeople}} 种计费方案，选一个收钱 👇</text>
    </view>

    <view class="card result-card" wx:for="{{allResults}}" wx:key="key">
      <view class="result-header">
        <text class="result-icon">{{item.icon}}</text>
        <view class="result-title-box">
          <text class="result-label">{{item.label}}</text>
          <text class="result-desc">{{item.desc}}</text>
        </view>
      </view>
      <view class="result-note" wx:if="{{item.note}}">{{item.note}}</view>
      <view class="result-rows" wx:if="{{item.rows.length > 0}}">
        <view class="result-row" wx:for="{{item.rows}}" wx:for-item="row" wx:key="label">
          <text class="row-label">{{row.label}}{{row.countText}}</text>
          <text class="row-amount {{row.isFree ? 'free' : ''}}">¥{{row.amount}}</text>
        </view>
      </view>
    </view>

    <view class="copy-btn" bindtap="copyAllResult">📋 复制全部结果到剪贴板</view>
  </block>
</view>
