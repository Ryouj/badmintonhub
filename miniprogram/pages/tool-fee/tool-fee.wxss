/* pages/tool-fee/tool-fee.wxss */
.page {
  padding: 20rpx 30rpx 60rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

/* 金额输入 */
.amount-input-row {
  display: flex;
  align-items: center;
  border-bottom: 4rpx solid #1aad19;
  padding: 10rpx 0;
}

.currency {
  font-size: 44rpx;
  color: #1aad19;
  font-weight: 700;
  margin-right: 10rpx;
}

.amount-input {
  flex: 1;
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
}

.detail-toggle {
  text-align: center;
  font-size: 24rpx;
  color: #1aad19;
  margin-top: 16rpx;
  padding: 8rpx;
}

.detail-list {
  margin-top: 16rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-label {
  font-size: 28rpx;
  color: #666;
}

.detail-input-box {
  display: flex;
  align-items: center;
}

.detail-currency {
  font-size: 26rpx;
  color: #999;
  margin-right: 4rpx;
}

.detail-input {
  width: 120rpx;
  font-size: 28rpx;
  text-align: right;
}

/* 模式选择 */
.mode-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.mode-chip {
  width: calc(50% - 8rpx);
  padding: 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  background: #fafafa;
}

.mode-chip.selected {
  border-color: #1aad19;
  background: #e8f5e9;
}

.mode-label {
  font-size: 28rpx;
  font-weight: 500;
  display: block;
}

.mode-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.mode-chip.selected .mode-desc {
  color: #1aad19;
}

/* 模式参数 */
.param-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.param-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
}

.param-input-box {
  display: flex;
  align-items: center;
}

.param-currency {
  font-size: 26rpx;
  color: #999;
  margin-right: 4rpx;
}

.param-input {
  width: 100rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1aad19;
  text-align: center;
}

.param-suffix {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 参与者列表 */
.player-list {
  margin-bottom: 12rpx;
}

.player-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 12rpx;
}

.player-num {
  font-size: 24rpx;
  color: #ccc;
  width: 36rpx;
  text-align: center;
  flex-shrink: 0;
}

.player-name {
  flex: 1;
  font-size: 28rpx;
  border-bottom: 1rpx solid #e0e0e0;
  padding: 4rpx 0;
}

.gender-toggle {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.gender-toggle.male {
  background: #e3f2fd;
  color: #1976d2;
}

.gender-toggle.female {
  background: #fce4ec;
  color: #c2185b;
}

.rounds-control {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.rounds-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
}

.rounds-val {
  font-size: 28rpx;
  font-weight: 600;
  min-width: 40rpx;
  text-align: center;
}

.tag-toggle {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: #f0f0f0;
  color: #999;
  flex-shrink: 0;
}

.tag-toggle.active {
  background: #fff3e0;
  color: #e65100;
}

.tag-toggle.loser {
  background: #ffebee;
  color: #c62828;
}

.tag-toggle.winner {
  background: #e8f5e9;
  color: #2e7d32;
}

.player-del {
  font-size: 32rpx;
  color: #ccc;
  padding: 8rpx;
  flex-shrink: 0;
}

.add-player {
  text-align: center;
  padding: 16rpx;
  font-size: 28rpx;
  color: #1aad19;
  border: 2rpx dashed #1aad19;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

/* 计算按钮 */
.calc-btn {
  background: #1aad19;
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin: 10rpx 0 20rpx;
}

/* 结果 */
.result-card {
  border: 2rpx solid #1aad19;
}

.result-note {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.result-list {
  margin-bottom: 16rpx;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.result-name {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.result-tag {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.result-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #e74c3c;
}

.result-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-top: 2rpx solid #e0e0e0;
}

.result-total-label {
  font-size: 30rpx;
  font-weight: 600;
}

.result-total-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #e74c3c;
}

.copy-btn {
  text-align: center;
  padding: 16rpx;
  background: #1aad19;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
}
