/* pages/tool-fee/tool-fee.wxss */
.page {
  padding: 20rpx 30rpx 60rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.card-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #bbb;
  margin-left: 8rpx;
}

/* ==================== 模式切换 tabs ==================== */
.mode-tabs {
  display: flex;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #999;
  border-radius: 10rpx;
  transition: all 0.2s;
}

.mode-tab.active {
  background: #1aad19;
  color: #fff;
  font-weight: 600;
}

.mode-panel { }

/* 模式输入行 */
.mode-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.mode-label {
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.mode-input-wrap {
  display: flex;
  align-items: center;
}

.mode-prefix {
  font-size: 28rpx;
  color: #999;
  margin-right: 4rpx;
}

.mode-input {
  width: 160rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1aad19;
  text-align: right;
}

.mode-input-sm {
  width: 100rpx;
}

.mode-suffix {
  font-size: 22rpx;
  color: #999;
  margin-left: 6rpx;
}

.mode-sub {
  background: #f9fdf9;
}

.mode-sub .mode-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #e67e22;
}

/* 分隔线 */
.mode-divider {
  text-align: center;
  padding: 16rpx 0 10rpx;
}

.mode-divider text {
  font-size: 24rpx;
  color: #aaa;
}

/* 单位切换 */
.unit-toggle {
  display: flex;
  background: #f0f0f0;
  border-radius: 8rpx;
  padding: 4rpx;
}

.unit-tab {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #999;
  border-radius: 6rpx;
  transition: all 0.2s;
}

.unit-tab.active {
  background: #fff;
  color: #1aad19;
  font-weight: 600;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.08);
}

/* 合计行 */
.mode-total-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 16rpx;
  background: #e8f5e9;
  border-radius: 10rpx;
}

.mode-total-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2e7d32;
}

.mode-total-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #e74c3c;
}

/* ==================== 金额输入（模式1直接输入） ==================== */
.amount-input-row {
  display: flex;
  align-items: center;
  border-bottom: 4rpx solid #1aad19;
  padding: 10rpx 0;
}

.currency {
  font-size: 44rpx;
  color: #1aad19;
  font-weight: 700;
  margin-right: 10rpx;
}

.amount-input {
  flex: 1;
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
}

.detail-toggle {
  text-align: center;
  font-size: 24rpx;
  color: #1aad19;
  margin-top: 16rpx;
  padding: 8rpx;
}

.detail-list { margin-top: 16rpx; }

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-label { font-size: 28rpx; color: #666; }

.detail-input-box { display: flex; align-items: center; }

.detail-currency { font-size: 26rpx; color: #999; margin-right: 4rpx; }

.detail-input { width: 120rpx; font-size: 28rpx; text-align: right; }

/* ==================== 人数输入 ==================== */
.count-row {
  display: flex;
  gap: 24rpx;
}

.count-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.count-icon { font-size: 40rpx; }
.male-icon { opacity: 1; }
.female-icon { opacity: 1; }

.count-stepper {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: auto;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid #1aad19;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #1aad19;
}

.stepper-input {
  width: 60rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.count-total {
  text-align: center;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #999;
}

/* ==================== 计费参数 ==================== */
.param-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.param-label {
  font-size: 28rpx;
  color: #333;
  width: 160rpx;
  flex-shrink: 0;
}

.param-prefix {
  font-size: 26rpx;
  color: #999;
  margin-right: 4rpx;
}

.param-input {
  width: 120rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1aad19;
  text-align: center;
}

.param-suffix {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

/* ==================== 计算按钮 ==================== */
.calc-btn {
  background: #1aad19;
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin: 10rpx 0 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(26,173,25,0.3);
}

/* ==================== 结果汇总 ==================== */
.result-summary {
  text-align: center;
  margin-bottom: 16rpx;
}

.summary-text {
  font-size: 26rpx;
  color: #999;
}

/* 结果卡片 */
.result-card {
  border-left: 6rpx solid #1aad19;
}

.result-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.result-icon { font-size: 36rpx; }

.result-title-box { display: flex; flex-direction: column; }

.result-label { font-size: 30rpx; font-weight: 600; color: #333; }

.result-desc { font-size: 22rpx; color: #999; }

.result-note {
  font-size: 22rpx;
  color: #e65100;
  background: #fff8e1;
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.result-rows { margin-bottom: 4rpx; }

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.row-label { font-size: 28rpx; color: #666; }

.row-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #e74c3c;
}

.row-amount.free { color: #4caf50; }

/* ==================== 复制按钮 ==================== */
.copy-btn {
  text-align: center;
  padding: 20rpx;
  background: #1aad19;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  margin-top: 16rpx;
  margin-bottom: 20rpx;
}
