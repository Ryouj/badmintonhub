/* pages/profile/profile.wxss - 卡片独立编辑 */
.page {
  padding-bottom: 60rpx;
}

/* === 头部 === */
.profile-header {
  background: linear-gradient(135deg, #1aad19, #0d8a0d);
  padding: 50rpx 30rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar-wrap {
  position: relative;
  margin-bottom: 16rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
}

.level-badge {
  position: absolute;
  bottom: -4rpx;
  right: -10rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #fff;
  background: #f39c12;
}
.level-beginner    { background: #95a5a6; }
.level-elementary  { background: #3498db; }
.level-intermediate { background: #f39c12; }
.level-advanced    { background: #e74c3c; }
.level-expert      { background: #9b59b6; }

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.bio {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
  max-width: 500rpx;
  text-align: center;
}

.edit-profile-btn {
  margin-top: 20rpx;
  padding: 8rpx 32rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #fff;
}

/* 基本资料行内编辑（header 区域内） */
.basic-edit {
  margin-top: 24rpx;
  width: 100%;
  max-width: 580rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.basic-edit-row {
  margin-bottom: 16rpx;
}

.be-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  display: block;
  margin-bottom: 8rpx;
}

.be-input {
  width: 100%;
  height: 64rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #333;
}

.be-textarea {
  width: 100%;
  min-height: 80rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  color: #333;
}

.basic-edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 16rpx;
}

.be-cancel, .be-save {
  padding: 8rpx 28rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.be-cancel {
  color: rgba(255,255,255,0.8);
  background: rgba(255,255,255,0.15);
}

.be-save {
  color: #1aad19;
  background: #fff;
  font-weight: 600;
}

/* === 卡片通用 === */
.card {
  margin: 0 20rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-toggle {
  font-size: 26rpx;
  color: #1aad19;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid #1aad19;
}

.section-toggle.active {
  background: #1aad19;
  color: #fff;
}

/* === 展示模式 === */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx 16rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.level-text {
  color: #1aad19;
  font-weight: 600;
}

/* === 编辑模式 === */
.edit-list {
  display: flex;
  flex-direction: column;
}

.edit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.edit-row:last-child {
  border-bottom: none;
}

.er-label {
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
  width: 160rpx;
}

.er-input {
  flex: 1;
  height: 64rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  text-align: right;
  box-sizing: border-box;
  color: #333;
}

.er-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 64rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #666;
}

.er-arrow {
  font-size: 24rpx;
  color: #bbb;
  margin-left: 8rpx;
}

/* === 数据统计 === */
.stats-row {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stats-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1aad19;
}

.stats-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}
