<!-- pages/profile/profile.wxml - 极简可选版 -->
<view class="page">

  <!-- === 头部大卡片 === -->
  <view class="header-card">
    <view class="hc-top">
      <view class="hc-avatar-wrap">
        <image class="hc-avatar" src="{{profile.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
        <view class="hc-level level-{{profile.skillLevel}}" wx:if="{{profile.skillLevelLabel}}">
          {{profile.skillLevelLabel}}
        </view>
      </view>
      <view class="hc-info">
        <text class="hc-nickname">{{profile.nickName || '羽球集用户'}}</text>
        <text class="hc-bio" wx:if="{{profile.bio}}">{{profile.bio}}</text>
        <text class="hc-edit-btn" wx:if="{{editingSection !== 'basic'}}" bindtap="toggleEdit" data-section="basic">✏️ 编辑资料</text>
      </view>
    </view>

    <!-- 基本资料行内编辑 -->
    <view wx:if="{{editingSection === 'basic'}}" class="basic-edit">
      <view class="be-avatar-row">
        <button class="be-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="be-avatar-preview" src="{{editForm.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
          <text class="be-avatar-hint">点击更换头像</text>
        </button>
      </view>
      <view class="be-row">
        <text class="be-label">昵称</text>
        <input class="be-input" type="nickname" value="{{editForm.nickName}}" bindinput="onFieldChange" data-field="nickName" placeholder="你的昵称" focus="{{false}}" />
      </view>
      <view class="be-row">
        <text class="be-label">简介</text>
        <textarea class="be-textarea" value="{{editForm.bio}}" bindinput="onFieldChange" data-field="bio" placeholder="介绍一下自己..." auto-height maxlength="80" />
        <text class="be-counter">{{bioCount}}/80</text>
      </view>
      <view class="be-actions">
        <text class="be-cancel" bindtap="cancelEdit">取消</text>
        <text class="be-save" bindtap="saveSection" data-section="basic">保存</text>
      </view>
    </view>

    <!-- 数据指标行 -->
    <view class="hc-stats">
      <view class="hcs-item">
        <text class="hcs-num">{{totalData.totalAmount || '--'}}</text>
        <text class="hcs-label">累计消费</text>
      </view>
      <view class="hcs-divider"></view>
      <view class="hcs-item">
        <text class="hcs-num">{{totalData.totalDuration || '--'}}</text>
        <text class="hcs-label">运动时长(h)</text>
      </view>
      <view class="hcs-divider"></view>
      <view class="hcs-item">
        <text class="hcs-num">{{totalData.totalCount || '--'}}</text>
        <text class="hcs-label">活动次数</text>
      </view>
    </view>
  </view>

  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="skeleton-area">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton-card">
      <view class="sk-title"></view>
      <view class="sk-grid">
        <block wx:for="{{[1,2,3,4]}}" wx:key="*this">
          <view class="sk-item">
            <view class="sk-label"></view>
            <view class="sk-value"></view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 实际内容 -->
  <view wx:else>

    <!-- 技术水平 -->
    <view class="card">
      <view class="card-head">
        <text class="card-icon">🏅</text>
        <text class="card-title">技术水平</text>
        <text class="card-toggle {{editingSection === 'skill' ? 'active' : ''}}"
              bindtap="{{editingSection === 'skill' ? 'saveSection' : 'toggleEdit'}}"
              data-section="skill">
          {{editingSection === 'skill' ? '完成' : (hasSkill ? '编辑' : '添加')}}
        </text>
      </view>

      <view class="edit-panel {{editingSection === 'skill' ? 'show' : ''}}">
        <view class="ep-row">
          <text class="ep-label">水平等级</text>
          <picker mode="selector" range="{{skillLevelOptions}}" range-key="label" bindchange="onPickerChange" data-field="skillLevel" data-label-field="skillLevelLabel" data-list="skillLevel">
            <view class="ep-picker">{{editForm.skillLevelLabel || '请选择'}}<text class="ep-arrow">▾</text></view>
          </picker>
        </view>
        <view class="ep-row">
          <text class="ep-label">球龄</text>
          <picker mode="selector" range="{{playYearsOptions}}" range-key="label" bindchange="onPickerChange" data-field="playYears" data-label-field="playYearsLabel" data-list="playYears">
            <view class="ep-picker">{{editForm.playYearsLabel || '请选择'}}<text class="ep-arrow">▾</text></view>
          </picker>
        </view>
        <view class="ep-row">
          <text class="ep-label">打球频率</text>
          <picker mode="selector" range="{{playFrequencyOptions}}" range-key="label" bindchange="onPickerChange" data-field="playFrequency" data-label-field="playFrequencyLabel" data-list="playFrequency">
            <view class="ep-picker">{{editForm.playFrequencyLabel || '请选择'}}<text class="ep-arrow">▾</text></view>
          </picker>
        </view>
        <view class="ep-row">
          <text class="ep-label">打球类型</text>
          <picker mode="selector" range="{{playStyleOptions}}" range-key="label" bindchange="onPickerChange" data-field="playStyle" data-label-field="playStyleLabel" data-list="playStyle">
            <view class="ep-picker">{{editForm.playStyleLabel || '请选择'}}<text class="ep-arrow">▾</text></view>
          </picker>
        </view>
      </view>

      <view wx:if="{{hasSkill}}" class="info-grid">
        <view class="ig-item" wx:if="{{profile.skillLevelLabel}}">
          <text class="ig-label">水平等级</text>
          <text class="ig-value level-text">{{profile.skillLevelLabel}}</text>
        </view>
        <view class="ig-item" wx:if="{{profile.playYears}}">
          <text class="ig-label">球龄</text>
          <text class="ig-value">{{profile.playYearsLabel}}</text>
        </view>
        <view class="ig-item" wx:if="{{profile.playFrequency}}">
          <text class="ig-label">打球频率</text>
          <text class="ig-value">{{profile.playFrequencyLabel}}</text>
        </view>
        <view class="ig-item" wx:if="{{profile.playStyle}}">
          <text class="ig-label">打球类型</text>
          <text class="ig-value">{{profile.playStyleLabel}}</text>
        </view>
      </view>
      <view wx:else class="empty-hint" bindtap="toggleEdit" data-section="skill">点此添加</view>
    </view>

    <!-- 常用装备 -->
    <view class="card">
      <view class="card-head">
        <text class="card-icon">🎯</text>
        <text class="card-title">常用装备</text>
        <text class="card-toggle {{editingSection === 'equipment' ? 'active' : ''}}"
              bindtap="{{editingSection === 'equipment' ? 'saveSection' : 'toggleEdit'}}"
              data-section="equipment">
          {{editingSection === 'equipment' ? '完成' : (hasEquip ? '编辑' : '添加')}}
        </text>
      </view>

      <view class="edit-panel {{editingSection === 'equipment' ? 'show' : ''}}">
        <view class="ep-row">
          <text class="ep-label">主力球拍</text>
          <input class="ep-input" value="{{editForm.mainRacket}}" bindinput="onFieldChange" data-field="mainRacket" placeholder="如 Yonex 天斧100ZZ" />
        </view>
        <view class="ep-row">
          <text class="ep-label">球鞋</text>
          <input class="ep-input" value="{{editForm.shoes}}" bindinput="onFieldChange" data-field="shoes" placeholder="如 Yonex 65Z3" />
        </view>
        <view class="ep-row">
          <text class="ep-label">常用球</text>
          <input class="ep-input" value="{{editForm.shuttleBrand}}" bindinput="onFieldChange" data-field="shuttleBrand" placeholder="如 Yonex AS50" />
        </view>
        <view class="ep-row">
          <text class="ep-label">拉线磅数</text>
          <input class="ep-input" type="digit" value="{{editForm.stringTension}}" bindinput="onFieldChange" data-field="stringTension" placeholder="如 26" />
        </view>
      </view>

      <view wx:if="{{hasEquip}}" class="info-grid">
        <view class="ig-item" wx:if="{{profile.mainRacket}}">
          <text class="ig-label">主力球拍</text>
          <text class="ig-value">{{profile.mainRacket}}</text>
        </view>
        <view class="ig-item" wx:if="{{profile.shoes}}">
          <text class="ig-label">球鞋</text>
          <text class="ig-value">{{profile.shoes}}</text>
        </view>
        <view class="ig-item" wx:if="{{profile.shuttleBrand}}">
          <text class="ig-label">常用球</text>
          <text class="ig-value">{{profile.shuttleBrand}}</text>
        </view>
        <view class="ig-item" wx:if="{{profile.stringTension}}">
          <text class="ig-label">拉线磅数</text>
          <text class="ig-value">{{profile.stringTensionDisplay}}</text>
        </view>
      </view>
      <view wx:else class="empty-hint" bindtap="toggleEdit" data-section="equipment">点此添加</view>
    </view>

    <!-- 打球偏好 -->
    <view class="card">
      <view class="card-head">
        <text class="card-icon">📍</text>
        <text class="card-title">打球偏好</text>
        <text class="card-toggle {{editingSection === 'preference' ? 'active' : ''}}"
              bindtap="{{editingSection === 'preference' ? 'saveSection' : 'toggleEdit'}}"
              data-section="preference">
          {{editingSection === 'preference' ? '完成' : (hasPref ? '编辑' : '添加')}}
        </text>
      </view>

      <view class="edit-panel {{editingSection === 'preference' ? 'show' : ''}}">
        <view class="ep-row">
          <text class="ep-label">常用球馆</text>
          <input class="ep-input" value="{{editForm.preferredVenue}}" bindinput="onFieldChange" data-field="preferredVenue" placeholder="如 XX羽毛球馆" />
        </view>
        <view class="ep-row">
          <text class="ep-label">所在城市</text>
          <input class="ep-input" value="{{editForm.city}}" bindinput="onFieldChange" data-field="city" placeholder="如 南京" />
        </view>
        <view class="ep-row">
          <text class="ep-label">擅长打法</text>
          <picker mode="selector" range="{{playTypes}}" bindchange="onPickerChange" data-field="playType">
            <view class="ep-picker">{{editForm.playType || '请选择'}}<text class="ep-arrow">▾</text></view>
          </picker>
        </view>
        <view class="ep-row">
          <text class="ep-label">惯用手</text>
          <picker mode="selector" range="{{hands}}" bindchange="onPickerChange" data-field="hand">
            <view class="ep-picker">{{editForm.hand || '请选择'}}<text class="ep-arrow">▾</text></view>
          </picker>
        </view>
      </view>

      <view wx:if="{{hasPref}}" class="info-grid">
        <view class="ig-item" wx:if="{{profile.preferredVenue}}">
          <text class="ig-label">常用球馆</text>
          <text class="ig-value">{{profile.preferredVenue}}</text>
        </view>
        <view class="ig-item" wx:if="{{profile.city}}">
          <text class="ig-label">所在城市</text>
          <text class="ig-value">{{profile.city}}</text>
        </view>
        <view class="ig-item" wx:if="{{profile.playType}}">
          <text class="ig-label">擅长打法</text>
          <text class="ig-value">{{profile.playType}}</text>
        </view>
        <view class="ig-item" wx:if="{{profile.hand}}">
          <text class="ig-label">惯用手</text>
          <text class="ig-value">{{profile.hand}}</text>
        </view>
      </view>
      <view wx:else class="empty-hint" bindtap="toggleEdit" data-section="preference">点此添加</view>
    </view>

  </view>
</view>
