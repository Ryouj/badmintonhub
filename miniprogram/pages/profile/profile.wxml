<!-- pages/profile/profile.wxml - 个人档案（卡片独立编辑） -->
<view class="page">
  <!-- 个人信息头部 -->
  <view class="profile-header">
    <view class="avatar-wrap">
      <image class="avatar" src="{{profile.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="level-badge level-{{profile.skillLevel}}">
        {{profile.skillLevelLabel || '未设置'}}
      </view>
    </view>
    <text class="nickname">{{profile.nickName || '点击设置昵称'}}</text>
    <text class="bio">{{profile.bio || '介绍一下你对羽毛球的热爱吧~'}}</text>

    <!-- 基本资料行内编辑 -->
    <view wx:if="{{editingSection === 'basic'}}" class="basic-edit">
      <view class="basic-edit-row">
        <text class="be-label">昵称</text>
        <input class="be-input" value="{{editForm.nickName}}" bindinput="onFieldChange" data-field="nickName" placeholder="你的昵称" focus />
      </view>
      <view class="basic-edit-row">
        <text class="be-label">简介</text>
        <textarea class="be-textarea" value="{{editForm.bio}}" bindinput="onFieldChange" data-field="bio" placeholder="介绍一下自己..." auto-height />
      </view>
      <view class="basic-edit-actions">
        <text class="be-cancel" bindtap="cancelEdit">取消</text>
        <text class="be-save" bindtap="saveSection" data-section="basic">保存</text>
      </view>
    </view>

    <text class="edit-profile-btn" wx:if="{{editingSection !== 'basic'}}" bindtap="toggleEdit" data-section="basic">✏️ 编辑资料</text>
  </view>

  <!-- 技术水平 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">🏅 技术水平</text>
      <text class="section-toggle {{editingSection === 'skill' ? 'active' : ''}}" bindtap="{{editingSection === 'skill' ? 'saveSection' : 'toggleEdit'}}" data-section="skill">
        {{editingSection === 'skill' ? '完成' : '编辑'}}
      </text>
    </view>
    <view wx:if="{{editingSection === 'skill'}}" class="edit-list">
      <view class="edit-row">
        <text class="er-label">水平等级</text>
        <picker mode="selector" range="{{skillLevelOptions}}" range-key="label" bindchange="onPickerChange" data-field="skillLevel" data-label-field="skillLevelLabel" data-list="skillLevel">
          <view class="er-picker">{{editForm.skillLevelLabel || '请选择'}}<text class="er-arrow">▾</text></view>
        </picker>
      </view>
      <view class="edit-row">
        <text class="er-label">球龄</text>
        <picker mode="selector" range="{{playYearsOptions}}" range-key="label" bindchange="onPickerChange" data-field="playYears" data-label-field="playYearsLabel" data-list="playYears">
          <view class="er-picker">{{editForm.playYearsLabel || '请选择'}}<text class="er-arrow">▾</text></view>
        </picker>
      </view>
      <view class="edit-row">
        <text class="er-label">打球频率</text>
        <picker mode="selector" range="{{playFrequencyOptions}}" range-key="label" bindchange="onPickerChange" data-field="playFrequency" data-label-field="playFrequencyLabel" data-list="playFrequency">
          <view class="er-picker">{{editForm.playFrequencyLabel || '请选择'}}<text class="er-arrow">▾</text></view>
        </picker>
      </view>
      <view class="edit-row">
        <text class="er-label">打球类型</text>
        <picker mode="selector" range="{{playStyleOptions}}" range-key="label" bindchange="onPickerChange" data-field="playStyle" data-label-field="playStyleLabel" data-list="playStyle">
          <view class="er-picker">{{editForm.playStyleLabel || '请选择'}}<text class="er-arrow">▾</text></view>
        </picker>
      </view>
    </view>
    <view wx:else class="info-grid">
      <view class="info-item">
        <text class="info-label">水平等级</text>
        <text class="info-value level-text">{{profile.skillLevelLabel || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">球龄</text>
        <text class="info-value">{{profile.playYearsLabel || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">打球频率</text>
        <text class="info-value">{{profile.playFrequencyLabel || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">打球类型</text>
        <text class="info-value">{{profile.playStyleLabel || '未设置'}}</text>
      </view>
    </view>
  </view>

  <!-- 常用装备 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">🎯 常用装备</text>
      <text class="section-toggle {{editingSection === 'equipment' ? 'active' : ''}}" bindtap="{{editingSection === 'equipment' ? 'saveSection' : 'toggleEdit'}}" data-section="equipment">
        {{editingSection === 'equipment' ? '完成' : '编辑'}}
      </text>
    </view>
    <view wx:if="{{editingSection === 'equipment'}}" class="edit-list">
      <view class="edit-row">
        <text class="er-label">主力球拍</text>
        <input class="er-input" value="{{editForm.mainRacket}}" bindinput="onFieldChange" data-field="mainRacket" placeholder="如：Yonex 天斧100ZZ" />
      </view>
      <view class="edit-row">
        <text class="er-label">球鞋</text>
        <input class="er-input" value="{{editForm.shoes}}" bindinput="onFieldChange" data-field="shoes" placeholder="如：Yonex 65Z3" />
      </view>
      <view class="edit-row">
        <text class="er-label">常用球</text>
        <input class="er-input" value="{{editForm.shuttleBrand}}" bindinput="onFieldChange" data-field="shuttleBrand" placeholder="如：Yonex AS50" />
      </view>
      <view class="edit-row">
        <text class="er-label">拉线磅数</text>
        <input class="er-input" type="digit" value="{{editForm.stringTension}}" bindinput="onFieldChange" data-field="stringTension" placeholder="如：26" />
      </view>
    </view>
    <view wx:else class="info-grid">
      <view class="info-item">
        <text class="info-label">主力球拍</text>
        <text class="info-value">{{profile.mainRacket || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">球鞋</text>
        <text class="info-value">{{profile.shoes || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">常用球</text>
        <text class="info-value">{{profile.shuttleBrand || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">拉线磅数</text>
        <text class="info-value">{{profile.stringTension ? profile.stringTension + '磅' : '未设置'}}</text>
      </view>
    </view>
  </view>

  <!-- 打球偏好 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">📍 打球偏好</text>
      <text class="section-toggle {{editingSection === 'preference' ? 'active' : ''}}" bindtap="{{editingSection === 'preference' ? 'saveSection' : 'toggleEdit'}}" data-section="preference">
        {{editingSection === 'preference' ? '完成' : '编辑'}}
      </text>
    </view>
    <view wx:if="{{editingSection === 'preference'}}" class="edit-list">
      <view class="edit-row">
        <text class="er-label">常用球馆</text>
        <input class="er-input" value="{{editForm.preferredVenue}}" bindinput="onFieldChange" data-field="preferredVenue" placeholder="如：XX羽毛球馆" />
      </view>
      <view class="edit-row">
        <text class="er-label">所在城市</text>
        <input class="er-input" value="{{editForm.city}}" bindinput="onFieldChange" data-field="city" placeholder="如：南京" />
      </view>
      <view class="edit-row">
        <text class="er-label">擅长打法</text>
        <picker mode="selector" range="{{playTypes}}" bindchange="onPickerChange" data-field="playType">
          <view class="er-picker">{{editForm.playType || '请选择'}}<text class="er-arrow">▾</text></view>
        </picker>
      </view>
      <view class="edit-row">
        <text class="er-label">惯用手</text>
        <picker mode="selector" range="{{hands}}" bindchange="onPickerChange" data-field="hand">
          <view class="er-picker">{{editForm.hand || '请选择'}}<text class="er-arrow">▾</text></view>
        </picker>
      </view>
    </view>
    <view wx:else class="info-grid">
      <view class="info-item">
        <text class="info-label">常用球馆</text>
        <text class="info-value">{{profile.preferredVenue || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">所在城市</text>
        <text class="info-value">{{profile.city || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">擅长打法</text>
        <text class="info-value">{{profile.playType || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">惯用手</text>
        <text class="info-value">{{profile.hand || '未设置'}}</text>
      </view>
    </view>
  </view>

  <!-- 个人数据 -->
  <view class="card">
    <view class="section-title">📈 我的数据</view>
    <view class="stats-row">
      <view class="stats-item">
        <text class="stats-num">{{totalData.totalAmount || '0'}}</text>
        <text class="stats-desc">累计消费(元)</text>
      </view>
      <view class="stats-item">
        <text class="stats-num">{{totalData.totalDuration || '0'}}</text>
        <text class="stats-desc">累计时长(小时)</text>
      </view>
      <view class="stats-item">
        <text class="stats-num">{{totalData.totalCount || '0'}}</text>
        <text class="stats-desc">总活动次数</text>
      </view>
    </view>
  </view>
</view>
