/* pages/stats/stats.wxss */
.page {
  padding-bottom: 40rpx;
}

/* 未登录浏览态 */
.loggedout {
  margin: 160rpx 40rpx;
  padding: 60rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.05);
}
.lo-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.lo-title { font-size: 36rpx; font-weight: 700; color: #333; margin-bottom: 12rpx; }
.lo-desc { font-size: 26rpx; color: #999; margin-bottom: 40rpx; }
.lo-btn {
  background: #1aad19;
  color: #fff;
  font-size: 30rpx;
  padding: 20rpx 80rpx;
  border-radius: 44rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #ccc;
}

/* 时间切换 */
.period-tabs {
  display: flex;
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #1aad19;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #1aad19;
  border-radius: 2rpx;
}

/* 总览卡片 */
.overview-card {
  display: flex;
  background: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.overview-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
}

.overview-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.overview-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 图表容器 */
.chart-container {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 10rpx 0;
}

.pie-chart {
  width: 340rpx;
  height: 340rpx;
}

.bar-chart {
  width: 100%;
  height: 360rpx;
}

/* 图例 */
.category-legend {
  margin-top: 10rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.legend-color {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.legend-label {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.legend-amount {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.legend-percent {
  font-size: 24rpx;
  color: #999;
  width: 70rpx;
  text-align: right;
}

/* 运动统计 */
.duration-stats {
  display: flex;
  text-align: center;
}

.duration-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20rpx 10rpx;
}

.duration-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1aad19;
}

.duration-unit {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 球馆排行 */
.venue-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.venue-name {
  font-size: 28rpx;
}

.venue-count {
  font-size: 26rpx;
  color: #999;
}
