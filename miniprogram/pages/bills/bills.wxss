/* pages/bills/bills.wxss - 多项目账单列表 */
.page { padding-bottom: 120rpx; }

/* 筛选栏 */
.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}
.filter-month { font-size: 30rpx; font-weight: 600; color: #333; }
.filter-summary { display: flex; gap: 20rpx; font-size: 24rpx; color: #999; }
.filter-amount { font-size: 26rpx; }

/* 分组 */
.bill-group { margin-bottom: 20rpx; }
.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 30rpx;
}
.group-date { font-size: 26rpx; color: #666; font-weight: 500; }
.group-total { font-size: 28rpx; }

/* 账单项 */
.bill-item {
  background: #fff;
  padding: 20rpx 30rpx 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

/* 多项目明细行 */
.bill-items-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.bill-sub-item {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}

.sub-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}
.sub-dot.chip-court     { background: #e74c3c; }
.sub-dot.chip-shuttle   { background: #f39c12; }
.sub-dot.chip-drink     { background: #3498db; }
.sub-dot.chip-transport { background: #2ecc71; }
.sub-dot.chip-stringing { background: #9b59b6; }
.sub-dot.chip-equipment { background: #1abc9c; }
.sub-dot.chip-other     { background: #7f8c8d; }

.sub-cat { font-size: 24rpx; color: #555; margin-right: 8rpx; }
.sub-amount { font-size: 24rpx; color: #e74c3c; font-weight: 500; }

/* 底部信息 */
.bill-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}
.bill-left {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.bill-time { font-size: 22rpx; color: #aaa; }
.bill-note {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 360rpx;
}
.bill-total { font-size: 32rpx; font-weight: 600; }

/* 金额通用 */
.amount { color: #e74c3c; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  font-size: 28rpx;
  color: #ccc;
}
.empty-state text:first-child { font-size: 80rpx; margin-bottom: 20rpx; }

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: #1aad19;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(26, 173, 25, 0.4);
}
.fab-icon { font-size: 48rpx; color: #fff; line-height: 1; }
