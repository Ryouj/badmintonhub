/* pages/login/login.wxss */
.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 80rpx 60rpx 40rpx;
  background: linear-gradient(180deg, #f1f8e9 0%, #f5f5f5 40%);
  box-sizing: border-box;
}

/* 品牌区 */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.brand-logo {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.brand-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #1aad19;
}

.brand-slogan {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
}

/* 头像选择 */
.avatar-section {
  margin-bottom: 40rpx;
}

.avatar-btn {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  border-radius: 50%;
  overflow: visible;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-shadow: 0 4rpx 20rpx rgba(26, 173, 25, 0.2);
}

.avatar-hint {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(26, 173, 25, 0.9);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.avatar-hint text {
  color: #fff;
  font-size: 20rpx;
}

/* 昵称输入 */
.nickname-section {
  width: 100%;
  margin-bottom: 50rpx;
}

.nickname-input {
  width: 100%;
  height: 96rpx;
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 48rpx;
  padding: 0 40rpx;
  font-size: 30rpx;
  color: #333;
  text-align: center;
  box-sizing: border-box;
}

.nickname-input:focus {
  border-color: #1aad19;
}

/* 操作区 */
.action-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-login {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #1aad19, #0d8a0d);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  margin-bottom: 24rpx;
}

.btn-login::after {
  border: none;
}

.btn-login[loading] {
  opacity: 0.7;
}

.skip-link {
  padding: 16rpx 40rpx;
}

.skip-link text {
  font-size: 26rpx;
  color: #999;
}
