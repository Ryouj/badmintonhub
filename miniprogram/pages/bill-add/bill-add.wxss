/* pages/bill-add/bill-add.wxss - 多项目记账 */
.page { padding-bottom: 60rpx; }

/* 表单行 */
.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.form-row-vertical {
  flex-direction: column;
  align-items: flex-start;
}
.form-label { font-size: 28rpx; color: #333; }
.form-picker { color: #666; font-size: 28rpx; }
.form-textarea {
  width: 100%;
  height: 100rpx;
  padding: 12rpx 0;
  font-size: 28rpx;
  margin-top: 8rpx;
}

/* 分区标题 */
.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  padding: 30rpx 0 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 项目列表 */
.item-list { margin-top: 8rpx; }

.item-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.item-category-picker { flex: 1; }

.category-chip {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  border: 2rpx solid #e0e0e0;
  color: #666;
}

.chip-court     { background: #fdecea; color: #e74c3c; border-color: #e74c3c; }
.chip-shuttle   { background: #fef5e7; color: #f39c12; border-color: #f39c12; }
.chip-drink     { background: #eaf4fd; color: #3498db; border-color: #3498db; }
.chip-stringing { background: #f3eef8; color: #9b59b6; border-color: #9b59b6; }
.chip-equipment { background: #e8f8f5; color: #1abc9c; border-color: #1abc9c; }
.chip-other     { background: #f2f3f4; color: #7f8c8d; border-color: #7f8c8d; }

.item-delete {
  font-size: 28rpx;
  color: #ccc;
  padding: 8rpx 16rpx;
}

.item-amount-row {
  display: flex;
  align-items: center;
}

.amount-sign {
  font-size: 40rpx;
  font-weight: 700;
  color: #e74c3c;
  margin-right: 8rpx;
}

.item-amount-input {
  font-size: 40rpx;
  font-weight: 600;
  color: #e74c3c;
  width: 250rpx;
  border-bottom: 2rpx solid #eee;
  padding: 6rpx 0;
}

/* 添加按钮 */
.add-item-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  margin: 16rpx 0;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  color: #999;
  font-size: 26rpx;
}
.add-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
  line-height: 1;
}

/* 合计栏 */
.total-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-top: 2rpx solid #f0f0f0;
  border-bottom: 2rpx solid #f0f0f0;
  margin: 12rpx 0 20rpx;
}
.total-label { font-size: 30rpx; color: #333; font-weight: 600; }
.total-amount { font-size: 44rpx; color: #e74c3c; font-weight: 700; }

/* 提交 */
.submit-section { padding: 30rpx 20rpx; }
.btn-submit {
  width: 100%;
  background: #1aad19;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
}
.btn-delete {
  width: 100%;
  margin-top: 20rpx;
  background: transparent;
  color: #e74c3c;
  border: 2rpx solid #e74c3c;
  border-radius: 12rpx;
  padding: 22rpx;
  font-size: 30rpx;
}
