/* pages/bill-add/bill-add.wxss - 多项目记账 */
.page { padding-bottom: 60rpx; }

/* 表单行 */
.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.form-row-vertical {
  flex-direction: column;
  align-items: flex-start;
}
.form-label { font-size: 28rpx; color: #333; }
.form-picker { color: #666; font-size: 28rpx; }
.form-input-inline {
  text-align: right;
  font-size: 28rpx;
  color: #333;
  flex: 1;
  margin-left: 20rpx;
}
.form-textarea {
  width: 100%;
  height: 100rpx;
  padding: 12rpx 0;
  font-size: 28rpx;
  margin-top: 8rpx;
}

/* 活动信息 */
.section-act-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.section-sub {
  font-size: 22rpx;
  color: #bbb;
  font-weight: 400;
}
.duration-inputs {
  display: flex;
  align-items: center;
}
.duration-input {
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 8rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 8rpx;
}
.duration-sep {
  margin: 0 8rpx;
  font-size: 26rpx;
  color: #666;
}

/* 分区标题 */
.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  padding: 30rpx 0 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 项目列表 */
.item-list { margin-top: 8rpx; }

.item-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.item-header {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 6rpx;
}

.item-delete {
  font-size: 28rpx;
  color: #ccc;
  padding: 4rpx 8rpx;
}

/* 类别选择按钮行 */
.chip-select-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.chip-select {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: 2rpx solid #e0e0e0;
  color: #999;
  background: #fafafa;
  transition: all 0.15s;
}

.chip-select.selected.chip-court     { background: #fdecea; color: #e74c3c; border-color: #e74c3c; }
.chip-select.selected.chip-shuttle   { background: #fef5e7; color: #f39c12; border-color: #f39c12; }
.chip-select.selected.chip-drink     { background: #eaf4fd; color: #3498db; border-color: #3498db; }
.chip-select.selected.chip-transport { background: #eafaf1; color: #2ecc71; border-color: #2ecc71; }
.chip-select.selected.chip-stringing { background: #f3eef8; color: #9b59b6; border-color: #9b59b6; }
.chip-select.selected.chip-equipment { background: #e8f8f5; color: #1abc9c; border-color: #1abc9c; }
.chip-select.selected.chip-other     { background: #f2f3f4; color: #7f8c8d; border-color: #7f8c8d; }

/* 快捷添加 */
.quick-add-section {
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx dashed #eee;
}
.quick-add-label {
  font-size: 22rpx;
  color: #bbb;
  margin-bottom: 12rpx;
  display: block;
}
.quick-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.quick-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 22rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
  border: 2rpx solid;
}
.quick-chip:active { opacity: 0.7; transform: scale(0.96); }
.quick-chip.court     { background: #fdecea; color: #e74c3c; border-color: #e74c3c; }
.quick-chip.shuttle   { background: #fef5e7; color: #f39c12; border-color: #f39c12; }
.quick-chip.drink     { background: #eaf4fd; color: #3498db; border-color: #3498db; }
.quick-chip.transport { background: #eafaf1; color: #2ecc71; border-color: #2ecc71; }
.quick-chip.stringing { background: #f3eef8; color: #9b59b6; border-color: #9b59b6; }
.quick-chip.equipment { background: #e8f8f5; color: #1abc9c; border-color: #1abc9c; }
.quick-chip.other     { background: #f2f3f4; color: #7f8c8d; border-color: #7f8c8d; }

.item-amount-row {
  display: flex;
  align-items: center;
}

.amount-sign {
  font-size: 40rpx;
  font-weight: 700;
  color: #e74c3c;
  margin-right: 8rpx;
}

.item-amount-input {
  font-size: 40rpx;
  font-weight: 600;
  color: #e74c3c;
  width: 250rpx;
  border-bottom: 2rpx solid #eee;
  padding: 6rpx 0;
}

/* 合计栏 */
.total-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-top: 2rpx solid #f0f0f0;
  border-bottom: 2rpx solid #f0f0f0;
  margin: 12rpx 0 20rpx;
}
.total-label { font-size: 30rpx; color: #333; font-weight: 600; }
.total-amount { font-size: 44rpx; color: #e74c3c; font-weight: 700; }

/* 提交 */
.submit-section { padding: 30rpx 20rpx; }
.btn-submit {
  width: 100%;
  background: #1aad19;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
}
.btn-delete {
  width: 100%;
  margin-top: 20rpx;
  background: transparent;
  color: #e74c3c;
  border: 2rpx solid #e74c3c;
  border-radius: 12rpx;
  padding: 22rpx;
  font-size: 30rpx;
}
