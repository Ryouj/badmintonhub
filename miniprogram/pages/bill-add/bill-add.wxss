/* pages/bill-add/bill-add.wxss */
.page {
  padding-bottom: 60rpx;
}

/* 金额输入 */
.amount-input-section {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 30rpx;
}

.currency {
  font-size: 56rpx;
  font-weight: 700;
  color: #e74c3c;
  margin-right: 8rpx;
}

.amount-input {
  font-size: 64rpx;
  font-weight: 700;
  color: #e74c3c;
  width: 300rpx;
  text-align: center;
}

/* 类别选择 */
.category-section {
  margin-bottom: 30rpx;
}

.form-section-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 10rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.category-item.active {
  border-color: #1aad19;
  background: #f0faf0;
}

.category-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.category-label {
  font-size: 26rpx;
  color: #666;
}

.category-item.active .category-label {
  color: #1aad19;
  font-weight: 500;
}

/* 表单 */
.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-row-vertical {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  font-size: 28rpx;
  color: #333;
}

.form-picker {
  color: #666;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  height: 120rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  margin-top: 10rpx;
}

/* 提交 */
.submit-section {
  padding: 30rpx 20rpx;
}

.btn-submit {
  width: 100%;
  background: #1aad19;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-delete {
  width: 100%;
  margin-top: 20rpx;
  background: transparent;
  color: #e74c3c;
  border: 2rpx solid #e74c3c;
  border-radius: 12rpx;
  padding: 22rpx;
  font-size: 30rpx;
}
