<!-- pages/bill-add/bill-add.wxml - 多项目记账页面 -->
<view class="page">
  <view class="card">
    <!-- 日期 -->
    <view class="form-row">
      <text class="form-label">日期</text>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="form-picker">{{form.date || '请选择日期'}}</view>
      </picker>
    </view>

    <!-- 时间 -->
    <view class="form-row">
      <text class="form-label">时间</text>
      <picker mode="time" value="{{form.time}}" bindchange="onTimeChange">
        <view class="form-picker">{{form.time || '请选择时间'}}</view>
      </picker>
    </view>

    <!-- 开销明细 -->
    <view class="section-title">📋 开销明细</view>
    <view class="item-list">
      <view class="item-row" wx:for="{{form.items}}" wx:key="index">
        <view class="item-header">
          <text class="item-delete" bindtap="removeItem" data-index="{{index}}" wx:if="{{form.items.length > 1}}">✕</text>
        </view>
        <view class="chip-select-row">
          <view 
            class="chip-select {{item.category === cat.key ? 'chip-' + cat.key + ' selected' : ''}}" 
            wx:for="{{categories}}" 
            wx:for-item="cat" 
            wx:key="key"
            bindtap="onItemCategoryTap" 
            data-index="{{index}}" 
            data-cat-key="{{cat.key}}" 
            data-cat-label="{{cat.label}}"
          >
            {{cat.icon}} {{cat.label}}
          </view>
        </view>
        <view class="item-amount-row">
          <text class="amount-sign">¥</text>
          <input class="item-amount-input" type="digit" value="{{item.amount}}" bindinput="onItemAmount" data-index="{{index}}" placeholder="0.00" />
        </view>
      </view>
    </view>

    <!-- 快捷添加类别 -->
    <view class="quick-add-section" wx:if="{{form.items.length < 8}}">
      <text class="quick-add-label">点击类别快速添加：</text>
      <view class="quick-chip-row">
        <view 
          class="quick-chip {{cat.key}}" 
          wx:for="{{categories}}" 
          wx:for-item="cat" 
          wx:key="key" 
          bindtap="quickAddItem" 
          data-cat-key="{{cat.key}}" 
          data-cat-label="{{cat.label}}"
        >
          {{cat.icon}} {{cat.label}}
        </view>
      </view>
    </view>

    <!-- 合计 -->
    <view class="total-bar">
      <text class="total-label">合计</text>
      <text class="total-amount">¥{{totalAmount}}</text>
    </view>

    <!-- 备注 -->
    <view class="form-row form-row-vertical">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" value="{{form.note}}" bindinput="onInput" data-field="note" placeholder="例如：周三固定局，6人AA..." />
    </view>

    <!-- 关联活动 -->
    <view class="form-row">
      <text class="form-label">关联活动</text>
      <picker mode="selector" range="{{activityLabels}}" bindchange="onActivityChange">
        <view class="form-picker">{{form.activityLabel || '不关联（可选）'}}</view>
      </picker>
    </view>
  </view>

  <!-- 提交 -->
  <view class="submit-section">
    <button class="btn-submit" bindtap="submitBill">
      {{isEdit ? '更新记录' : '记录支出'}}
    </button>
    <button class="btn-delete" wx:if="{{isEdit}}" bindtap="deleteBill">删除此记录</button>
  </view>
</view>
