<!-- pages/index/index.wxml - 首页 -->
<view class="page">
  <!-- 未登录浏览提示（不强制，用户可自主选择登录） -->
  <view wx:if="{{loggedOut}}" class="login-banner">
    <view class="lb-text">登录后开启记账、统计与个人资料功能</view>
    <view class="lb-btn" bindtap="goLogin">登录 / 注册</view>
  </view>

  <!-- 顶部摘要卡片 -->
  <view class="header-card">
    <view class="header-top">
      <view class="user-greeting">
        <text class="greeting-text">🏸 羽球集</text>
        <text class="greeting-sub">记录每一拍的热爱</text>
      </view>
      <view class="header-avatar" bindtap="goProfile">
        <image src="{{userInfo.avatarUrl || '/images/default-avatar.svg'}}" mode="aspectFill" />
      </view>
    </view>
    
    <!-- 本月概览 -->
    <view class="summary-row">
      <view class="summary-item">
        <text class="summary-value amount">{{monthStats.totalAmount || '0.00'}}</text>
        <text class="summary-label">本月花费</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <text class="summary-value">{{monthStats.totalDuration || 0}}h</text>
        <text class="summary-label">本月时长</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <text class="summary-value">{{monthStats.totalCount || 0}}</text>
        <text class="summary-label">活动次数</text>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="goAddBill">
      <view class="action-icon action-icon-bill">🏸</view>
      <text class="action-label">记一笔</text>
    </view>
    <view class="action-item" bindtap="goStats">
      <view class="action-icon action-icon-chart">📊</view>
      <text class="action-label">看统计</text>
    </view>
    <view class="action-item" bindtap="goTools">
      <view class="action-icon action-icon-tool">🧰</view>
      <text class="action-label">工具箱</text>
    </view>
    <view class="action-item" bindtap="goProfile">
      <view class="action-icon action-icon-me">👤</view>
      <text class="action-label">我的</text>
    </view>
  </view>

  <!-- 最近记录 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">最近记录</text>
      <text class="section-more" bindtap="goBills">全部 ></text>
    </view>
    
    <block wx:if="{{recentBills.length > 0}}">
      <view class="bill-item" wx:for="{{recentBills}}" wx:key="id" bindtap="goBillDetail" data-id="{{item.id}}">
        <view class="bill-items-row">
          <view class="bill-sub-tag" wx:for="{{item.items}}" wx:key="id" wx:for-item="sub">
            <text class="tag-cat">{{sub.categoryLabel}}</text>
            <text class="tag-amount">¥{{sub.amountText || sub.amount}}</text>
          </view>
        </view>
        <view class="bill-footer-row">
          <text class="bill-date">{{item.dateText}}</text>
          <text class="bill-total amount">¥{{item.totalText}}</text>
        </view>
      </view>
    </block>
    
    <view class="empty-state" wx:elif="{{!loggedOut}}">
      <text>🏸</text>
      <text>还没有记录，快去记一笔吧</text>
    </view>
    <view class="empty-state" wx:else>
      <text>🔒</text>
      <text>登录后查看你的记录</text>
    </view>
  </view>

  <!-- 最近活动 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">最近活动</text>
      <text class="section-more" bindtap="goActivityList">更多 ></text>
    </view>
    
    <block wx:if="{{recentActivities.length > 0}}">
      <view class="activity-item" wx:for="{{recentActivities}}" wx:key="id">
        <view class="activity-left">
          <text class="activity-date">{{item.dateText}}</text>
          <text class="activity-duration">⏱ {{item.durationText}}</text>
        </view>
        <view class="activity-right">
          <text class="activity-location">📍 {{item.location || '未记录'}}</text>
          <text class="activity-bill-count" wx:if="{{item.billCount > 0}}" bindtap="goBills">关联 {{item.billCount}} 笔消费</text>
        </view>
      </view>
    </block>
    
    <view class="empty-state" wx:elif="{{!loggedOut}}">
      <text>📅</text>
      <text>还没有活动记录</text>
    </view>
    <view class="empty-state" wx:else>
      <text>🔒</text>
      <text>登录后查看你的活动</text>
    </view>
  </view>
</view>
