/* pages/tool-fucai3d/tool-fucai3d.wxss */
.page {
  padding: 20rpx 30rpx 60rpx;
}

.page-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}
.page-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #222;
}
.page-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.disclaimer {
  background: #fff7e6;
  border: 2rpx solid #ffd591;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}
.disclaimer-text {
  font-size: 22rpx;
  color: #ad6800;
  line-height: 1.5;
}

.gen-btn {
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 18rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(231, 76, 60, 0.3);
}
.gen-btn-hover {
  opacity: 0.85;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #333;
}
.card-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #bbb;
  margin-left: 8rpx;
}

/* 推荐号码网格 */
.rec-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.rec-item {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  background: #fafafa;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 16rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.rec-double {
  background: #fdeceb;
  border-color: #f5b7b1;
}
.rec-num {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #c0392b;
}
.rec-reason {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
}
.rec-tag {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  background: #e67e22;
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 0 12rpx 0 12rpx;
}
.rec-tag-dan {
  background: #c0392b;
}

/* 两列 / 三列块 */
.row-2, .row-3 {
  display: flex;
  gap: 16rpx;
}
.row-2 .mini-block {
  flex: 1;
}
.row-3 .mini-block {
  flex: 1;
}
.mini-block {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.mini-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.mini-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  letter-spacing: 2rpx;
}
.mini-value.dan {
  color: #e67e22;
}
.mini-value.kill {
  font-size: 26rpx;
  color: #888;
}
.mini-sub {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}

/* 近期开奖 */
.recent-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}
.recent-row:last-child {
  border-bottom: none;
}
.recent-issue {
  font-size: 24rpx;
  color: #666;
  width: 140rpx;
}
.recent-date {
  font-size: 22rpx;
  color: #bbb;
  width: 180rpx;
}
.recent-nums {
  display: flex;
  gap: 10rpx;
  flex: 1;
  justify-content: flex-end;
}
.recent-num {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #c0392b;
  color: #fff;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 600;
}

.tool-tip {
  text-align: center;
  margin-top: 10rpx;
}
.tool-tip text {
  font-size: 20rpx;
  color: #ccc;
}
